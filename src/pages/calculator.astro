---
import Base from '../layouts/Base.astro';
import { compareCgt, type CgtInput } from '../lib/cgt.ts';
import { formatWholeDollars } from '../lib/dollars.ts';
import { href } from '../lib/site.ts';
import { renderCgtResult } from '../scripts/cgt-view.ts';

const jane = { purchaseDate: '2022-07-01', costBase: 800000, valueAt2027: 1131371, saleDate: '2032-07-01', salePrice: 1600000, otherIncome: 150000, inflation: 2.5, incomeSupport: false, newDwelling: false };
const examples = [
  { label: 'Property held since 2022', values: jane },
  { label: 'Shares bought after July 2027', values: { purchaseDate: '2027-07-01', costBase: 100000, valueAt2027: '', saleDate: '2032-07-01', salePrice: 125000, otherIncome: 150000, inflation: 2.5, incomeSupport: false, newDwelling: false } },
  { label: 'Low income: 30% minimum kicks in', values: { purchaseDate: '2027-08-01', costBase: 100000, valueAt2027: '', saleDate: '2032-08-01', salePrice: 140000, otherIncome: 20000, inflation: 2.5, incomeSupport: false, newDwelling: false } },
  { label: 'Pre-1985 asset', values: { purchaseDate: '1984-06-01', costBase: 60000, valueAt2027: 1200000, saleDate: '2030-07-01', salePrice: 1400000, otherIncome: 90000, inflation: 2.5, incomeSupport: false, newDwelling: false } },
];
const initial: CgtInput = { ...jane, inflation: jane.inflation / 100 };
// Whole-dollar fields: shown as "$1,131,371" and reformatted as the reader types (src/scripts/dollar-field.ts).
const dollarField = { type: 'text', inputmode: 'numeric', autocomplete: 'off', 'data-dollars': '' };
---

<Base title="CGT calculator: old rules vs new rules" description="Estimate capital gains tax on a sale after 1 July 2027 under the new indexation and 30% minimum tax rules, compared with the 50% discount." current="calculator/">
  <section class="wrap section">
    <div class="section-head">
      <p class="kicker">Estimate only · general information</p>
      <h1 class="display">CGT calculator</h1>
      <p>See how the tax on one sale changes when the 50% discount gives way to indexation and a 30% minimum. Built on the formulas in the Act and checked against the Government's worked examples. <a href={href('changes/cgt-discount-indexation/')}>How the change works</a>.</p>
    </div>

    <div class="calc">
      <form id="cgt-form" class="calc-form" novalidate={false}>
        <div class="examples">
          <p class="kicker">Try an example</p>
          {examples.map((e) => <button type="button" class="btn" data-example={JSON.stringify(e.values)}>{e.label}</button>)}
        </div>

        <fieldset>
          <legend class="kicker">The asset</legend>
          <label>Purchase date (contract date)<input type="date" name="purchaseDate" required value={jane.purchaseDate} /></label>
          <label>What it cost you<span class="help">Price plus stamp duty, legal fees and improvements</span><input {...dollarField} name="costBase" required pattern="\$?0*[1-9][\d,]*" title="An amount of $1 or more" value={formatWholeDollars(jane.costBase)} /></label>
          <label>Value just before 1 July 2027 (optional)<span class="help">Only for assets you hold on 30 June 2027. Leave blank to estimate with the draft apportioning method.</span><input {...dollarField} name="valueAt2027" value={formatWholeDollars(jane.valueAt2027)} /></label>
          <label class="check"><input type="checkbox" name="newDwelling" /> It's a qualifying new build and I keep the 50% discount</label>
        </fieldset>

        <fieldset>
          <legend class="kicker">The sale</legend>
          <label>Sale date (on or after 1 July 2027)<input type="date" name="saleDate" required min="2027-07-01" value={jane.saleDate} /></label>
          <label>Sale price<span class="help">After selling costs</span><input {...dollarField} name="salePrice" required value={formatWholeDollars(jane.salePrice)} /></label>
        </fieldset>

        <fieldset>
          <legend class="kicker">You, in the year you sell</legend>
          <label>Other taxable income<span class="help">Salary, rent, dividends and so on</span><input {...dollarField} name="otherIncome" required value={formatWholeDollars(jane.otherIncome)} /></label>
          <label class="check"><input type="checkbox" name="incomeSupport" /> I'll receive income support such as the Age Pension or JobSeeker that year</label>
          <label>Assumed inflation, % a year<input type="number" name="inflation" required min="0" max="20" step="0.1" value={jane.inflation} /></label>
        </fieldset>

        <button type="submit" class="btn go">Compare</button>
      </form>

      <div id="cgt-out" class="calc-out" tabindex="-1" aria-live="polite">
        <Fragment set:html={renderCgtResult(compareCgt(initial))} />
      </div>
    </div>
    <p class="fine muted">Estimates for one asset sold by one Australian-resident individual. They include an approximate 2% Medicare levy but ignore other gains and losses, offsets and your personal circumstances. Not tax advice: check with a registered tax agent.</p>
  </section>
</Base>

<script>
  import { mountCalculator } from '../scripts/calculator.ts';
  const form = document.getElementById('cgt-form') as HTMLFormElement | null;
  const out = document.getElementById('cgt-out');
  if (form && out) mountCalculator(form, out);
</script>

<style>
  h1 { font-size: clamp(56px, 10vw, 120px); }
  .calc { display: grid; gap: var(--s7); align-items: start; }
  .calc-form { display: grid; gap: var(--s5); }
  .examples { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; }
  .examples .kicker { width: 100%; }
  fieldset { border: 0; border-top: var(--rule-mid) solid var(--ink); padding: var(--s3) 0 0; margin: 0; display: grid; gap: var(--s4); }
  legend { padding: 0 var(--s2) 0 0; }
  label { display: grid; gap: var(--s1); font-weight: 600; }
  .help { font-weight: 400; font-size: 14px; color: var(--muted); }
  input[type='text'], input[type='number'], input[type='date'] {
    min-height: 48px; padding: var(--s2) var(--s3); font: 500 18px var(--font-mono);
    border: var(--rule-thin) solid var(--ink); border-radius: 0; background: var(--paper);
  }
  .check { display: flex; gap: var(--s3); align-items: center; font-weight: 400; min-height: 44px; }
  .check input { width: 22px; height: 22px; accent-color: var(--shift); }
  .go { justify-self: start; background: var(--shift); border-color: var(--shift); color: var(--on-shift); font-size: 16px; padding-inline: var(--s6); min-height: 52px; }
  .go:hover { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .calc-out { border-top: var(--rule-heavy) solid var(--shift); padding-top: var(--s4); display: grid; gap: var(--s4); }
  .calc-out:focus { outline: none; }
  .calc-out :global(.calc-cols) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
  .calc-out :global(.calc-col) { border-top: var(--rule-mid) solid var(--ink); padding-top: var(--s2); display: grid; gap: var(--s1); }
  .calc-out :global(.calc-gain) { font-size: 14px; }
  .calc-out :global(.calc-gain strong) { font: 900 28px/1 var(--font-display); letter-spacing: 0; margin-left: var(--s2); }
  .calc-out :global(.calc-big) { font-size: clamp(40px, 5.5vw, 72px); overflow-wrap: anywhere; }
  .calc-out :global(.is-new .calc-big) { color: var(--shift); }
  .calc-out :global(.calc-diff) { font-size: clamp(36px, 5vw, 56px); }
  .calc-out :global(.calc-diff.is-more) { background: var(--shift); color: var(--on-shift); padding: var(--s2) var(--s3) 0; justify-self: start; }
  .calc-out :global(.calc-table) { width: 100%; border-collapse: collapse; }
  .calc-out :global(.calc-table caption) { text-align: left; padding-bottom: var(--s2); }
  .calc-out :global(.calc-table th), .calc-out :global(.calc-table td) { text-align: left; padding: var(--s2) 0; border-bottom: 1px solid var(--rule); font-weight: 400; vertical-align: top; }
  .calc-out :global(.calc-table td), .calc-out :global(.calc-table thead th + th) { text-align: right; padding-left: var(--s3); white-space: nowrap; }
  .calc-out :global(.calc-table thead th) { border-bottom: var(--rule-thin) solid var(--ink); }
  .calc-out :global(.calc-table .is-strong th), .calc-out :global(.calc-table .is-strong td) { font-weight: 800; border-top: var(--rule-thin) solid var(--ink); }
  .calc-out :global(.calc-table td:last-child) { color: var(--shift); }
  .calc-out :global(.calc-notes) { padding-left: 1.2em; display: grid; gap: var(--s2); font-size: 15px; color: var(--muted); }
  .calc-out :global(.calc-error) { background: var(--shift); color: var(--on-shift); padding: var(--s3); font-weight: 600; }
  .fine { margin-top: var(--s6); font-size: 14px; max-width: 72ch; }
  @media (min-width: 1000px) { .calc { grid-template-columns: 5fr 6fr; } .calc-out { position: sticky; top: var(--s4); } }
</style>
